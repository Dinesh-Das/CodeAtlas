{
  "name": "codeatlas",
  "version": "0.1.0",
  "description": "Local-first structural intelligence for software repositories.",
  "type": "module",
  "bin": {
    "codeatlas": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "code-intelligence",
    "knowledge-graph",
    "mcp",
    "developer-tools"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "ignore": "7.0.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "26.3.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
