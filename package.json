{
  "name": "@dinesh-das/codeatlas",
  "version": "0.11.0-beta.1",
  "mcpName": "io.github.dinesh-das/codeatlas",
  "description": "Evidence-first code intelligence for AI coding agents, with verified and inferred repository relationships through MCP.",
  "author": {
    "name": "Dinesh Das",
    "url": "https://github.com/Dinesh-Das"
  },
  "type": "module",
  "bin": {
    "codeatlas": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "examples",
    "server.json",
    "compatibility.json"
  ],
  "scripts": {
    "clean:dist": "node scripts/clean-dist.mjs",
    "build": "npm run clean:dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "lint": "oxlint src scripts --disable-unicorn-plugin --deny-warnings",
    "benchmark": "npm run build && node scripts/benchmark.mjs --profile smoke",
    "benchmark:full": "npm run build && node scripts/benchmark.mjs --profile full",
    "benchmark:real": "npm run build && node scripts/benchmark-real.mjs",
    "eval:validate": "npm run build && node scripts/evaluate.mjs --suite evals/development.json --verify-fixtures",
    "eval:report": "npm run build && node scripts/evaluate.mjs",
    "eval:provider": "npm run build && node scripts/run-provider-eval.mjs",
    "check": "npm run typecheck && npm run lint && npm test && node scripts/evaluate.mjs --suite evals/development.json --verify-fixtures && node scripts/run-provider-eval.mjs --suite evals/development.json --provider codex --model fixture-model --model-version fixture-version --dry-run",
    "prepack": "npm run build",
    "package:smoke": "node scripts/package-smoke.mjs",
    "distribution:check": "node scripts/validate-distribution.mjs",
    "adapter:check": "node scripts/validate-adapter-fixture.mjs examples/adapter-kit/expected.json examples/adapter-kit/actual.json",
    "release:gate": "node scripts/release-gate.mjs",
    "validate:repository": "npm run build && node scripts/validate-release-repository.mjs",
    "release:check": "npm run check && npm run distribution:check && npm run package:smoke && npm run release:gate",
    "stable:check": "npm run release:check && node scripts/release-gate.mjs --stable"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "code-intelligence",
    "knowledge-graph",
    "mcp",
    "developer-tools",
    "static-analysis",
    "call-graph",
    "typescript",
    "go",
    "java",
    "rust",
    "model-context-protocol",
    "ai-coding-agent",
    "repository-analysis",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dinesh-Das/CodeAtlas.git"
  },
  "homepage": "https://github.com/Dinesh-Das/CodeAtlas#readme",
  "bugs": {
    "url": "https://github.com/Dinesh-Das/CodeAtlas/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "12.8.0",
    "commander": "15.0.0",
    "ignore": "7.0.6",
    "picomatch": "4.0.7",
    "tree-sitter": "0.21.1",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-rust": "0.23.1",
    "tree-sitter-typescript": "0.23.2",
    "typescript-compiler": "npm:typescript@5.9.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "26.3.0",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
