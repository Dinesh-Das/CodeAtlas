{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dinesh-das/codeatlas",
  "description": "Evidence-backed repository context and change preparation for coding agents.",
  "repository": {
    "url": "https://github.com/Dinesh-Das/CodeAtlas",
    "source": "github"
  },
  "version": "0.11.0-beta.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@dinesh-das/codeatlas",
      "version": "0.11.0-beta.1",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "valueHint": "repository_path",
          "description": "Absolute path to the repository CodeAtlas should serve.",
          "isRequired": true,
          "format": "filepath"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
